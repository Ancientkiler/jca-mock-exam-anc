# MongoDB connection string. Required.
MONGODB_URI=

# Database name. Must match the project name.
MONGODB_DB=jca-mock-exam

# Long random string used to sign session cookies. Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Seeded admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated passwords for user1..user5, in order.
SEED_USER_PASSWORDS=test1,test2,test3,test4,test5
